LLM_MODEL=auto
STEP_GENERATION_RUNS=4
LLM_TIMEOUT_SECONDS=180

# Local reference verification (no Google credentials)
VERIFY_DB=outputs/verification/pipeline.sqlite3
VERIFY_CACHE=outputs/verification/sources
VERIFY_WORKERS=4
VERIFY_USER_AGENT=CanadianBenchmarkVerifier/1.0
# Comma-separated additional trusted public-institution hostnames after review:
VERIFY_AUTHORITY_HOSTS=
